# =====================================================================
#  Biến môi trường cho /api/sync (Vercel) và các lệnh chạy cục bộ.
#  • Trên Vercel: Project → Settings → Environment Variables (đặt cho Production;
#    đổi biến xong phải Redeploy thì mới có hiệu lực).
#  • Cục bộ: sao chép thành .env (đã có trong .gitignore và .vercelignore). KHÔNG commit giá trị thật.
#    Chỉ điền những gì cần: SHEET_ID cho `npm run dry-run`, FIREBASE_SERVICE_ACCOUNT khi Sheet đã riêng tư.
#    Không đặt SYNC_SECRET/CRON_SECRET ở máy cục bộ trừ khi chạy `vercel dev`; khi xem trước bằng
#    `python3 -m http.server` luôn thêm `--bind 127.0.0.1` (máy chủ này phục vụ cả tệp .env).
#  • Repo này CÔNG KHAI: tệp này chỉ chứa giá trị mẫu.
#  Tạo chuỗi bí mật ngẫu nhiên:  openssl rand -hex 32
# =====================================================================

# ---------- Firebase Admin (BẮT BUỘC – chọn MỘT trong hai cách) ----------
# Cách 1 (khuyên dùng): dán NGUYÊN nội dung tệp JSON khóa service account.
# Nên tạo service account riêng chỉ có vai trò “Cloud Datastore User” (Google Cloud console → IAM & Admin →
# Service Accounts – xem README, bước 2); cách nhanh nhưng quyền rộng hơn: Firebase console → Project settings →
# Service accounts → Generate new private key.
# Service account này cũng dùng để đọc Google Sheet: chia sẻ quyền Xem của Sheet cho client_email của nó và đặt
# Sheet ở chế độ “Bị hạn chế” (BẮT BUỘC – Sheet công khai thì ai có link cũng đọc được toàn bộ dữ liệu).
# Chấp nhận JSON thô hoặc chuỗi base64 của JSON. Không commit tệp khóa.
FIREBASE_SERVICE_ACCOUNT=

# Cách 2: khai báo 3 biến rời (bỏ dấu # ở đầu dòng). Khóa riêng giữ nguyên các ký tự \n.
# FIREBASE_PROJECT_ID=dugiotih
# FIREBASE_CLIENT_EMAIL=dashboard-sync@dugiotih.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Google Sheet – nguồn dữ liệu gốc (BẮT BUỘC) ----------
# Mã Sheet: đoạn giữa /d/ và /edit trong đường dẫn Sheet.
# Repo công khai → mã thật CHỈ đặt trên Vercel / tệp .env cục bộ, không ghi vào mã nguồn.
SHEET_ID=thay-bang-ma-google-sheet
# gid của trang “Câu trả lời biểu mẫu” (số sau #gid= trên thanh địa chỉ). Mặc định 948197065.
SHEET_GID_FORM=948197065
# gid của trang “DS Nhân sự”. Mặc định 979319376. Để trống (SHEET_GID_STAFF=) = không đọc danh sách nhân sự.
SHEET_GID_STAFF=979319376

# ---------- Bí mật cho các nguồn kích hoạt đồng bộ ----------
# Apps Script gửi “Authorization: Bearer <SYNC_SECRET>” (đặt cùng giá trị trong Script Properties).
# Mọi người có quyền sửa Google Sheet đều đọc được giá trị này → đổi khi có người rời trường.
SYNC_SECRET=thay-bang-chuoi-ngau-nhien-64-ky-tu
# Vercel Cron tự gửi “Authorization: Bearer <CRON_SECRET>” khi biến này được đặt. Thiếu → cron bị từ chối.
# Chỉ CRON_SECRET mới dùng được ?force=1 (ghi lại toàn bộ dữ liệu).
CRON_SECRET=thay-bang-mot-chuoi-ngau-nhien-khac

# ---------- Ai được xem dashboard (đăng nhập bằng tài khoản Microsoft 365) ----------
# Trang dashboard chỉ nhận tài khoản @hoangmaistarschool.edu.vn; các biến dưới đây dùng để THU HẸP quyền
# trong phạm vi tài khoản của trường.
# Tên miền được xem (viết thường, không có @).
# KHÔNG đặt biến này (hoặc để trống) → mặc định hoangmaistarschool.edu.vn (mọi tài khoản M365 của trường).
# none               → tắt cấp quyền theo tên miền (chỉ còn danh sách email bên dưới).
# Lưu ý: nếu học sinh cũng có tài khoản @hoangmaistarschool.edu.vn thì họ cũng xem được kết quả
# đánh giá giáo viên → khi đó nên đặt ALLOWED_DOMAINS=none và ACCESS_FROM_SHEET=all.
ALLOWED_DOMAINS=hoangmaistarschool.edu.vn

# Email được xem thêm (tài khoản @hoangmaistarschool.edu.vn, cách nhau bằng dấu phẩy).
# Dùng khi đã đặt ALLOWED_DOMAINS=none. Để trống nếu không cần.
ALLOWED_EMAILS=

# Lấy thêm email từ cột Email của trang “DS Nhân sự”:
#   bgh (mặc định) = chỉ các dòng Ban Giám Hiệu
#   all            = mọi nhân sự đang làm việc (bỏ qua người có ghi chú “nghỉ”)
#   0              = không lấy email từ Sheet
ACCESS_FROM_SHEET=bgh
